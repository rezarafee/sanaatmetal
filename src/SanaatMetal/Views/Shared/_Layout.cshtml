@inject SettingsService SettingsSvc
@inject IConfiguration Config
@{
    var s = await SettingsSvc.GetAsync();
    var company = L.Pick(s.CompanyNameFa, s.CompanyNameEn);
    var title = ViewData["Title"] as string;
    var path = Context.Request.Path.Value ?? "/";
    var returnUrl = path + Context.Request.QueryString;
    // ---------- SEO: canonical، hreflang و Open Graph ----------
    var baseUrl = Seo.BaseUrl(Context);
    // صفحه‌ها می‌توانند آدرس canonical خودشان را بدهند (مثلاً لیست محصولات با دسته و شماره صفحه)
    var canonicalRel = ViewData["Canonical"] as string ?? Context.Request.Path.ToUriComponent();
    var canonicalFa = baseUrl + canonicalRel;
    var canonical = Seo.WithLang(canonicalFa, L.Code);
    var metaTitle = string.IsNullOrEmpty(title) ? company : $"{title} | {company}";
    var metaDesc = Seo.Describe(ViewData["Description"] as string) ?? Seo.Describe(L.Pick(s.SloganFa, s.SloganEn)) ?? company;
    var ogImage = Seo.Abs(Context, ViewData["OgImage"] as string ?? s.OgImagePath ?? "/img/brand/og-image.png");
    // ---------- ظاهر سایت (پنل: ظاهر سایت) ----------
    var logo = string.IsNullOrEmpty(s.LogoPath) ? "/img/brand/logo-mark.svg" : s.LogoPath;
    var footerLogo = s.FooterLogoPath ?? logo;
    var logoClass = "logo-" + ThemeCss.Pick(s.LogoShape, ThemeCss.LogoShapes);
    var brandEn = L.Pick(s.CompanyNameEn, s.CompanyNameFa);
    var robots = ViewData["Robots"] as string ?? "index, follow, max-image-preview:large";
    // لینک تغییر زبان: همان صفحه با ?lang= (قابل دنبال کردن برای موتور جستجو)
    var qb = new Microsoft.AspNetCore.Http.Extensions.QueryBuilder(Context.Request.Query.Where(q => q.Key != "lang").SelectMany(q => q.Value.Select(v => new KeyValuePair<string, string>(q.Key, v ?? ""))));
    qb.Add("lang", L.Other);
    var switchUrl = Context.Request.Path.ToUriComponent() + qb.ToQueryString();
    string Active(string p) => (p == "/" ? path == "/" : path.StartsWith(p)) ? "active" : "";
    var texts = System.Text.Json.JsonSerializer.Serialize(new
    {
        added = L["Added"], call = L["CallForPrice"], remove = L["Remove"], empty = L["CartEmpty"], @continue = L["ContinueShopping"], close = L["Close"],
    });
}
<!DOCTYPE html>
<html lang="@L.Code" dir="@L.Dir" data-bs-theme="light" data-default-theme="@ThemeCss.Pick(s.ThemeMode, ThemeCss.Modes)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@metaTitle</title>
    <meta name="description" content="@metaDesc" />
    <meta name="robots" content="@robots" />
    <link rel="canonical" href="@canonical" />
    <link rel="alternate" hreflang="fa" href="@canonicalFa" />
    <link rel="alternate" hreflang="en" href="@Seo.WithLang(canonicalFa, "en")" />
    <link rel="alternate" hreflang="x-default" href="@canonicalFa" />
    @if (Config["Seo:GoogleVerification"] is { Length: > 0 } gsv) { <meta name="google-site-verification" content="@gsv" /> }
    <script src="~/js/theme-init.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    @if (L.IsFa)
    {
        <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.rtl.min.css" />
    }
    else
    {
        <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.min.css" />
    }
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/swiper/swiper-bundle.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="/theme.css?v=@ThemeCss.Version(s)" />
    @if (!string.IsNullOrEmpty(s.FaviconPath))
    {
        <link rel="icon" href="@s.FaviconPath" type="image/png" />
        <link rel="apple-touch-icon" href="@s.FaviconPath" />
    }
    else
    {
        <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
        <link rel="apple-touch-icon" href="~/apple-touch-icon.png" />
    }
    <meta name="theme-color" content="@(ThemeCss.Hex(s.ThemePrimary) ?? "#22318a")" />
    <meta property="og:site_name" content="@company" />
    <meta property="og:type" content="@(ViewData["OgType"] as string ?? "website")" />
    <meta property="og:title" content="@(string.IsNullOrEmpty(title) ? company : title)" />
    <meta property="og:description" content="@metaDesc" />
    <meta property="og:url" content="@canonical" />
    <meta property="og:image" content="@ogImage" />
    <meta property="og:locale" content="@(L.IsFa ? "fa_IR" : "en_US")" />
    <meta property="og:locale:alternate" content="@(L.IsFa ? "en_US" : "fa_IR")" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@metaTitle" />
    <meta name="twitter:description" content="@metaDesc" />
    <meta name="twitter:image" content="@ogImage" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body data-lang="@L.Code" data-currency="@L.Pick(s.CurrencyFa, s.CurrencyEn)" data-reveal="@ThemeCss.Pick(s.RevealAnimation, ThemeCss.Reveals)" data-hover="@ThemeCss.Pick(s.HoverEffect, ThemeCss.Hovers)" class="hero-decor-@ThemeCss.Pick(s.HeroDecor, ThemeCss.HeroDecors) @logoClass">
    <script type="application/json" id="sm-texts">@Html.Raw(texts)</script>

    <div class="sm-topbar py-2 d-none d-md-block">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex gap-4">
                @foreach (var o in s.Offices().Where(o => !string.IsNullOrWhiteSpace(o.Phone)))
                {
                    <a href="tel:@o.Phone!.Replace(" ", "")" dir="ltr"><i class="bi bi-telephone ic"></i>@o.Phone</a>
                }
                @if (!string.IsNullOrEmpty(s.Email))
                {
                    <a href="mailto:@s.Email" class="d-none d-lg-inline"><i class="bi bi-envelope ic"></i>@s.Email</a>
                }
                @if (!string.IsNullOrEmpty(s.WorkingHoursFa))
                {
                    <span><i class="bi bi-clock ic"></i>@L.Pick(s.WorkingHoursFa, s.WorkingHoursEn)</span>
                }
            </div>
            <a href="@switchUrl" hreflang="@L.Other" rel="alternate"><i class="bi bi-translate ic"></i>@L["Language"]</a>
        </div>
    </div>

    <nav class="navbar navbar-expand-lg sm-nav py-2">
        <div class="container">
            <a class="sm-brand" href="/">
                <span class="sm-brand-logo"><img src="@logo" alt="@company" /></span>
                @if (s.ShowBrandText)
                {
                    <span class="min-w-0">
                        <span class="sm-brand-name d-block">@(L.IsEn ? brandEn : company)</span>
                        <span class="sm-brand-sub d-none d-sm-block d-lg-none d-xxl-block">@L.Pick(s.SloganFa, s.SloganEn)</span>
                    </span>
                }
            </a>

            <div class="d-flex align-items-center gap-2 order-lg-last">
                <button class="btn btn-sm-outline btn-icon theme-toggle" type="button" title="@L["ThemeToggle"]" aria-label="@L["ThemeToggle"]">
                    <i class="bi bi-moon-stars"></i><i class="bi bi-sun"></i>
                </button>
                <a class="btn btn-sm-outline btn-icon d-md-none" href="@switchUrl" hreflang="@L.Other" rel="alternate" aria-label="language"><i class="bi bi-translate"></i></a>
                <button class="btn btn-sm-primary btn-icon sm-cart-btn" type="button" data-bs-toggle="offcanvas" data-bs-target="#miniCart" aria-label="@L["Cart"]">
                    <i class="bi bi-bag"></i><span class="sm-cart-badge d-none">0</span>
                </button>
                <button class="navbar-toggler border-0 px-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#mainNav" aria-controls="mainNav" aria-label="menu">
                    <i class="bi bi-list"></i>
                </button>
            </div>

            <div class="offcanvas offcanvas-start sm-menu" tabindex="-1" id="mainNav" aria-labelledby="mainNavLabel">
                <div class="offcanvas-header">
                    <span class="sm-brand" id="mainNavLabel">
                        <span class="sm-brand-logo"><img src="@logo" alt="" /></span>
                        <span class="sm-brand-name">@company</span>
                    </span>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                </div>
                <div class="offcanvas-body flex-grow-1">
                <ul class="navbar-nav mx-auto">
                    <li class="nav-item"><a class="nav-link @Active("/")" href="/">@L["Home"]</a></li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle @Active("/products")" href="/products" role="button" data-bs-toggle="dropdown">@L["Products"]</a>
                        <ul class="dropdown-menu p-2">
                            <li><a class="dropdown-item rounded-3 fw-bold" href="/products"><i class="bi bi-grid ic"></i>@L["AllProducts"]</a></li>
                            <li><hr class="dropdown-divider"></li>
                            @await Component.InvokeAsync("NavCategories")
                        </ul>
                    </li>
                    @if (s.ShowDownloads) { <li class="nav-item"><a class="nav-link @Active("/downloads")" href="/downloads">@L["Downloads"]</a></li> }
                    <li class="nav-item"><a class="nav-link @Active("/about")" href="/about">@L["About"]</a></li>
                    <li class="nav-item"><a class="nav-link @Active("/contact")" href="/contact">@L["Contact"]</a></li>
                </ul>
                <form class="d-flex d-lg-none d-xl-flex my-2 my-lg-0 me-lg-3 ms-lg-3" action="/products" method="get" role="search">
                    <div class="input-group">
                        <input class="form-control" type="search" name="q" placeholder="@L["SearchPlaceholder"]" aria-label="@L["Search"]" maxlength="100">
                        <button class="btn btn-sm-outline" type="submit" aria-label="@L["Search"]"><i class="bi bi-search"></i></button>
                    </div>
                </form>
                </div>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="sm-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <a class="sm-brand mb-3" href="/">
                        <span class="sm-brand-logo"><img src="@footerLogo" alt="" /></span>
                        @if (s.ShowBrandText) { <span class="sm-brand-name" style="color:var(--sm-footer-head)">@(L.IsEn ? brandEn : company)</span> }
                    </a>
                    <p class="mt-3" style="line-height:2">@L.Pick(s.SloganFa, s.SloganEn)</p>
                    <div class="social mt-3">
                        @if (!string.IsNullOrEmpty(s.Instagram)) { <a href="@Fmt.SafeUrl(s.Instagram)" target="_blank" rel="noopener" aria-label="Instagram"><i class="bi bi-instagram"></i></a> }
                        @if (!string.IsNullOrEmpty(s.Telegram)) { <a href="@Fmt.SafeUrl(s.Telegram)" target="_blank" rel="noopener" aria-label="Telegram"><i class="bi bi-telegram"></i></a> }
                        @if (!string.IsNullOrEmpty(s.WhatsApp)) { <a href="@Fmt.SafeUrl(s.WhatsApp)" target="_blank" rel="noopener" aria-label="WhatsApp"><i class="bi bi-whatsapp"></i></a> }
                        @if (!string.IsNullOrEmpty(s.LinkedIn)) { <a href="@Fmt.SafeUrl(s.LinkedIn)" target="_blank" rel="noopener" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a> }
                    </div>
                </div>
                <div class="col-6 col-lg-2">
                    <h5>@L["QuickLinks"]</h5>
                    <ul>
                        <li><a href="/products">@L["Products"]</a></li>
                        @if (s.ShowDownloads) { <li><a href="/downloads">@L["Downloads"]</a></li> }
                        <li><a href="/about">@L["About"]</a></li>
                        <li><a href="/contact">@L["Contact"]</a></li>
                        <li><a href="/cart">@L["Cart"]</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h5>@L["Categories"]</h5>
                    <ul>@await Component.InvokeAsync("NavCategories", new { plain = true })</ul>
                </div>
                <div class="col-lg-4">
                    <h5>@L["Contact"]</h5>
                    <ul>
                        @foreach (var o in s.Offices())
                        {
                            var ot = L.Pick(o.TitleFa, o.TitleEn);
                            <li class="sm-foot-office">
                                <b>@(string.IsNullOrWhiteSpace(ot) ? L["Office" + o.No] : ot)</b>
                                @if (!string.IsNullOrWhiteSpace(o.AddressFa)) { <span><i class="bi bi-geo-alt text-warning ic"></i>@L.Pick(o.AddressFa, o.AddressEn)</span> }
                                @if (!string.IsNullOrWhiteSpace(o.Phone)) { <span><i class="bi bi-telephone text-warning ic"></i><a href="tel:@o.Phone.Replace(" ", "")" dir="ltr">@o.Phone</a></span> }
                            </li>
                        }
                        @if (!string.IsNullOrEmpty(s.Mobile)) { <li><i class="bi bi-phone text-warning ic"></i><a href="tel:@s.Mobile" dir="ltr">@s.Mobile</a></li> }
                        @if (!string.IsNullOrEmpty(s.Email)) { <li><i class="bi bi-envelope text-warning ic"></i><a href="mailto:@s.Email">@s.Email</a></li> }
                    </ul>
                </div>
            </div>
        </div>
        <div class="sm-footer-bottom">
            <div class="container d-flex flex-wrap justify-content-between gap-2">
                <span>© @(L.IsFa ? Fmt.FaDigits(new System.Globalization.PersianCalendar().GetYear(DateTime.Now).ToString()) : DateTime.Now.Year.ToString()) @company — @L["Rights"]</span>
                <a href="@switchUrl" hreflang="@L.Other" rel="alternate"><i class="bi bi-translate ic"></i>@L["Language"]</a>
            </div>
        </div>
    </footer>

    <!-- Mini cart -->
    <div class="offcanvas offcanvas-end" tabindex="-1" id="miniCart" aria-labelledby="miniCartLabel">
        <div class="offcanvas-header border-bottom">
            <h5 class="offcanvas-title fw-bold" id="miniCartLabel"><i class="bi bi-bag ic"></i>@L["Cart"]</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="@L["Close"]"></button>
        </div>
        <div class="offcanvas-body p-0" id="mini-cart-items"></div>
        <div class="p-3 border-top d-none" id="mini-cart-foot">
            <div class="d-flex justify-content-between mb-3"><span class="text-muted">@L["CartTotal"]</span><b id="mini-cart-total"></b></div>
            <a href="/cart" class="btn btn-sm-accent w-100">@L["ViewCart"] <i class="bi bi-arrow-left-short"></i></a>
        </div>
    </div>

    <div class="sm-toast">
        <div id="sm-toast" class="toast align-items-center" role="status" aria-live="polite" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill text-success fs-5"></i><span></span>
                    <a href="/cart" class="ms-2 me-2 fw-bold">@L["ViewCart"]</a></div>
                <button type="button" class="btn-close me-2 ms-2 m-auto" data-bs-dismiss="toast" aria-label="@L["Close"]"></button>
            </div>
        </div>
    </div>
    <nav class="sm-mbar" aria-label="@L["Products"]">
        <a href="/products" class="@Active("/products")"><i class="bi bi-grid"></i>@L["Products"]</a>
        <a href="/cart" class="@Active("/cart")"><i class="bi bi-bag"></i><span class="sm-cart-badge d-none">0</span>@L["Cart"]</a>
        <a href="/contact" class="@Active("/contact")"><i class="bi bi-envelope"></i>@L["Contact"]</a>
        @if (!string.IsNullOrEmpty(s.Phone)) { <a href="tel:@s.Phone" class="call"><i class="bi bi-telephone"></i>@L["CallShort"]</a> } else { <a href="/" class="@Active("/")"><i class="bi bi-house"></i>@L["Home"]</a> }
    </nav>
    <button class="back-top" type="button" aria-label="top"><i class="bi bi-arrow-up"></i></button>

    <script src="~/lib/bootstrap/bootstrap.bundle.min.js"></script>
    <script src="~/lib/swiper/swiper-bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model List<SanaatMetal.Areas.Admin.Controllers.CustomersController.CustomerRow>
@{ ViewData["Title"] = "خریداران"; int page = ViewBag.Page, pages = ViewBag.Pages; }
<div class="a-card">
    <div class="a-card-head"><h5><i class="bi bi-person-vcard ic text-primary"></i>خریداران</h5><a class="btn btn-a btn-sm" asp-action="Edit"><i class="bi bi-plus-lg ic"></i>خریدار جدید</a></div>
    <form class="a-card-body border-bottom row g-2" method="get">
        <div class="col-md-10"><input class="form-control" name="q" value="@ViewBag.Q" placeholder="موبایل، نام یا شرکت..." /></div>
        <div class="col-md-2"><button class="btn btn-soft w-100"><i class="bi bi-search ic"></i>جستجو</button></div>
    </form>
    <div class="table-responsive">
        <table class="table a-table table-hover">
            <thead><tr><th>موبایل</th><th>نام</th><th>شرکت</th><th>شهر</th><th>سفارش‌ها</th><th>فاکتورها</th><th>ثبت</th><th></th></tr></thead>
            <tbody>
                @foreach (var r in Model)
                {
                    var c = r.Customer;
                    <tr><td><a class="ltr d-inline-block fw-bold" href="tel:@c.Mobile">@c.Mobile</a></td><td>@c.FullName</td><td>@c.CompanyName</td><td>@c.City</td><td>@N(r.Orders)</td><td>@N(r.Invoices)</td><td class="small text-muted">@D(c.CreatedAt)</td>
                        <td><div class="a-actions"><a class="btn btn-soft-primary" asp-action="Edit" asp-route-id="@c.Id"><i class="bi bi-pencil"></i></a></div></td></tr>
                }
            </tbody>
        </table>
        @if (Model.Count == 0) { <div class="a-empty"><i class="bi bi-people"></i>خریداری ثبت نشده است.</div> }
    </div>
    @if (pages > 1) { <nav class="p-3"><ul class="pagination justify-content-center mb-0">@for (var i = 1; i <= pages; i++) { <li class="page-item @(i == page ? "active" : "")"><a class="page-link" asp-route-page="@i" asp-route-q="@ViewBag.Q">@N(i)</a></li> }</ul></nav> }
</div>

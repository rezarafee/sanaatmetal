@model Client
@{ ViewData["Title"] = Model.Id == 0 ? "افزودن مشتری" : "ویرایش " + Model.NameFa; }
<form method="post" enctype="multipart/form-data" asp-route-id="@(Model.Id == 0 ? null : Model.Id)">
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="a-card a-card-body">
                <div asp-validation-summary="All" class="text-danger small"></div>
                <div class="row g-3">
                    <div class="col-md-6"><label class="form-label">نام شرکت (فارسی) *</label><input class="form-control" asp-for="NameFa" required /></div>
                    <div class="col-md-6"><label class="form-label">نام شرکت (انگلیسی)</label><input class="form-control ltr" asp-for="NameEn" /></div>
                    <div class="col-md-6"><label class="form-label">وب‌سایت</label><input class="form-control ltr" asp-for="Website" placeholder="https://..." /></div>
                    <div class="col-md-6"><label class="form-label">صنعت</label><input class="form-control" asp-for="Industry" placeholder="پالایش نفت" /></div>
                    <div class="col-12"><label class="form-label">توضیح</label><textarea class="form-control" asp-for="Description" rows="3"></textarea></div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="a-card a-card-body">
                <label class="form-label">لوگو</label>
                <img class="w-100 rounded-4 border mb-2 p-2" style="aspect-ratio:16/9;object-fit:contain" src="@(Model.LogoPath ?? "/img/placeholder.svg")" data-preview-for="logo" alt="" />
                <input type="file" class="form-control mb-3" name="logo" id="logo" accept=".jpg,.jpeg,.png,.webp" />
                <label class="form-label">ترتیب</label><input class="form-control mb-3" asp-for="SortOrder" type="number" />
                <div class="form-check form-switch mb-3"><input class="form-check-input" asp-for="IsActive" /><label class="form-check-label" asp-for="IsActive">نمایش در سایت</label></div>
                <button class="btn btn-a w-100"><i class="bi bi-check2 ic"></i>ذخیره</button>
                <a asp-action="Index" class="btn btn-soft w-100 mt-2">انصراف</a>
            </div>
        </div>
    </div>
</form>

@model Category
@{
    ViewData["Title"] = Model.Id == 0 ? "دسته‌بندی جدید" : "ویرایش دسته‌بندی";
    var parents = (List<Category>)ViewBag.Parents;
}
<form method="post" enctype="multipart/form-data" asp-route-id="@(Model.Id == 0 ? null : Model.Id)">
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="a-card a-card-body">
                <div asp-validation-summary="All" class="text-danger small"></div>
                <div class="row g-3">
                    <div class="col-md-6"><label class="form-label">نام فارسی *</label><input class="form-control" asp-for="NameFa" required /></div>
                    <div class="col-md-6"><label class="form-label">نام انگلیسی</label><input class="form-control ltr" asp-for="NameEn" /></div>
                    <div class="col-md-6"><label class="form-label">نامک (آدرس)</label><input class="form-control ltr" asp-for="Slug" placeholder="خودکار از نام انگلیسی" /></div>
                    <div class="col-md-6">
                        <label class="form-label">دسته والد</label>
                        <select class="form-select" asp-for="ParentId">
                            <option value="">— بدون والد —</option>
                            @foreach (var p in parents) { <option value="@p.Id" selected="@(Model.ParentId == p.Id)">@p.NameFa</option> }
                        </select>
                    </div>
                    <div class="col-md-6"><label class="form-label">توضیح فارسی</label><textarea class="form-control" asp-for="DescriptionFa" rows="3"></textarea></div>
                    <div class="col-md-6"><label class="form-label">توضیح انگلیسی</label><textarea class="form-control ltr" asp-for="DescriptionEn" rows="3"></textarea></div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="a-card a-card-body">
                <label class="form-label">تصویر</label>
                <img class="w-100 rounded-4 mb-2 border" style="aspect-ratio:4/3;object-fit:contain" src="@(Model.ImagePath ?? "/img/placeholder.svg")" data-preview-for="image" alt="" />
                <input type="file" class="form-control mb-3" name="image" id="image" accept=".jpg,.jpeg,.png,.webp" data-img />
                <label class="form-label">آیکون (Bootstrap Icons)</label>
                <input class="form-control ltr mb-3" asp-for="Icon" placeholder="bi-gear" />
                <label class="form-label">ترتیب نمایش</label>
                <input class="form-control mb-3" asp-for="SortOrder" type="number" />
                <div class="form-check form-switch mb-3"><input class="form-check-input" asp-for="IsActive" /><label class="form-check-label" asp-for="IsActive">فعال</label></div>
                <button class="btn btn-a w-100"><i class="bi bi-check2 ic"></i>ذخیره</button>
                <a asp-action="Index" class="btn btn-soft w-100 mt-2">انصراف</a>
            </div>
        </div>
    </div>
</form>

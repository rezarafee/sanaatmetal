@model List<Category>
@{
    ViewData["Title"] = "دسته‌بندی‌ها";
    var counts = (Dictionary<int, int>)ViewBag.Counts;
}
<div class="a-card">
    <div class="a-card-head">
        <h5><i class="bi bi-diagram-3 ic text-primary"></i>دسته‌بندی محصولات</h5>
        <a class="btn btn-a btn-sm" asp-action="Edit"><i class="bi bi-plus-lg ic"></i>دسته‌بندی جدید</a>
    </div>
    <div class="table-responsive">
        <table class="table a-table table-hover">
            <thead><tr><th></th><th>نام</th><th>نام انگلیسی</th><th>نامک</th><th>والد</th><th>محصولات</th><th>ترتیب</th><th>وضعیت</th><th></th></tr></thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td><img class="a-thumb" src="@(c.ImagePath ?? "/img/placeholder.svg")" alt="" /></td>
                        <td class="fw-bold">@(c.ParentId != null ? "— " : "")<i class="bi @(c.Icon ?? "bi-box") ic text-muted"></i>@c.NameFa</td>
                        <td class="ltr">@c.NameEn</td>
                        <td class="ltr small text-muted">@c.Slug</td>
                        <td>@c.Parent?.NameFa</td>
                        <td>@N(counts.GetValueOrDefault(c.Id))</td>
                        <td>@N(c.SortOrder)</td>
                        <td>@if (c.IsActive) { <span class="pill pill-green">فعال</span> } else { <span class="pill pill-gray">غیرفعال</span> }</td>
                        <td>
                            <div class="a-actions">
                                <a class="btn btn-soft-primary" asp-action="Edit" asp-route-id="@c.Id" title="ویرایش"><i class="bi bi-pencil"></i></a>
                                <form method="post" asp-action="Delete" asp-route-id="@c.Id" data-confirm="دسته‌بندی «@c.NameFa» حذف شود؟"><button class="btn btn-soft-danger" title="حذف"><i class="bi bi-trash3"></i></button></form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (Model.Count == 0) { <div class="a-empty"><i class="bi bi-diagram-3"></i>هنوز دسته‌بندی ثبت نشده است.</div> }
    </div>
</div>

@model List<Order>
@{
    ViewData["Title"] = "سفارش‌های سایت";
    OrderStatus? st = ViewBag.Status;
    int page = ViewBag.Page, pages = ViewBag.Pages;
}
<div class="a-card">
    <div class="a-card-head"><h5><i class="bi bi-cart-check ic text-warning"></i>سفارش‌های ثبت‌شده از سبد خرید سایت</h5></div>
    <form class="a-card-body border-bottom row g-2" method="get">
        <div class="col-md-6"><input class="form-control" name="q" value="@ViewBag.Q" placeholder="شماره سفارش، موبایل، نام یا شرکت..." /></div>
        <div class="col-md-4"><select class="form-select" name="status" data-autosubmit><option value="">همه وضعیت‌ها</option>@foreach (var s in Enum.GetValues<OrderStatus>()) { <option value="@s" selected="@(st == s)">@s.DisplayName()</option> }</select></div>
        <div class="col-md-2"><button class="btn btn-soft w-100"><i class="bi bi-search ic"></i>جستجو</button></div>
    </form>
    <div class="table-responsive">
        <table class="table a-table table-hover">
            <thead><tr><th>شماره</th><th>تاریخ</th><th>موبایل</th><th>نام / شرکت</th><th>اقلام</th>@if (Can(Permissions.PricingView) || Can(Permissions.InvoicesView)) { <th>جمع تقریبی</th> }<th>وضعیت</th><th></th></tr></thead>
            <tbody>
                @foreach (var o in Model)
                {
                    <tr>
                        <td class="ltr fw-bold">@o.Number</td><td class="small">@D(o.CreatedAt, true)</td>
                        <td><a class="ltr d-inline-block" href="tel:@o.Mobile">@o.Mobile</a></td>
                        <td>@o.FullName<div class="small text-muted">@o.CompanyName</div></td>
                        <td>@N(o.Items.Count)</td>
                        @if (Can(Permissions.PricingView) || Can(Permissions.InvoicesView)) { <td class="num">@N(o.EstimatedTotal)</td> }
                        <td><partial name="_OrderStatus" model="o.Status" /></td>
                        <td><div class="a-actions"><a class="btn btn-soft-primary" asp-action="Details" asp-route-id="@o.Id"><i class="bi bi-eye"></i></a></div></td>
                    </tr>
                }
            </tbody>
        </table>
        @if (Model.Count == 0) { <div class="a-empty"><i class="bi bi-cart"></i>سفارشی یافت نشد.</div> }
    </div>
    @if (pages > 1)
    {
        <nav class="p-3"><ul class="pagination justify-content-center mb-0">@for (var i = 1; i <= pages; i++) { <li class="page-item @(i == page ? "active" : "")"><a class="page-link" asp-route-page="@i" asp-route-q="@ViewBag.Q" asp-route-status="@st">@N(i)</a></li> }</ul></nav>
    }
</div>

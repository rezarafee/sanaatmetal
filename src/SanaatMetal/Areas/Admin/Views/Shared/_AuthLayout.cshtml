@inject SanaatMetal.Services.SettingsService SiteSettingsSvc
@{
    Layout = null;
    var site = await SiteSettingsSvc.GetAsync();
}
<!DOCTYPE html>
<html lang="fa" dir="rtl" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/fonts.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
</head>
<body>
    <div class="a-login">
        <div class="a-login-card">
            <div class="text-center mb-4">
                <div class="a-brand-logo a-brand-logo-lg mx-auto mb-3"><img src="@(string.IsNullOrEmpty(site.LogoPath) ? "/img/brand/logo-mark.svg" : site.LogoPath)" alt="@site.CompanyNameFa" width="84" height="84" /></div>
                <h1 class="h3 mb-1" style="font-family:Titr,Lalezar,Vazirmatn">@site.CompanyNameFa</h1>
                @if (!string.IsNullOrWhiteSpace(site.CompanyNameEn)) { <div class="mb-2 fw-bold ltr" style="font-size:1rem">@site.CompanyNameEn</div> }
                <p class="text-white-50 small mb-0">@ViewData["Title"]</p>
            </div>
            @RenderBody()
            <div class="text-center mt-4 d-flex justify-content-center gap-3">
                @RenderSection("Links", required: false)
                <a href="/" class="text-white-50 small"><i class="bi bi-arrow-right ic"></i>بازگشت به سایت</a>
            </div>
        </div>
    </div>
</body>
</html>

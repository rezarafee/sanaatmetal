@model List<Invoice>
@{ ViewData["Title"] = "فاکتورهای حذف‌شده"; }
<div class="a-card">
    <div class="a-card-head"><h5><i class="bi bi-trash3 ic text-danger"></i>سطل بازیافت فاکتورها</h5><a asp-action="Index" class="btn btn-soft btn-sm">بازگشت</a></div>
    <div class="table-responsive">
        <table class="table a-table">
            <thead><tr><th>شماره</th><th>خریدار</th><th>مبلغ</th><th>حذف توسط</th><th>زمان حذف</th><th></th></tr></thead>
            <tbody>
                @foreach (var i in Model)
                {
                    <tr><td class="ltr fw-bold">@i.Number</td><td>@i.CustomerName</td><td class="num">@N(i.GrandTotal)</td><td>@i.DeletedByName</td><td>@D(i.DeletedAt, true)</td>
                        <td><form method="post" asp-action="Restore" asp-route-id="@i.Id"><button class="btn btn-soft-success btn-sm"><i class="bi bi-arrow-counterclockwise ic"></i>بازگردانی</button></form></td></tr>
                }
            </tbody>
        </table>
        @if (Model.Count == 0) { <div class="a-empty"><i class="bi bi-trash"></i>سطل بازیافت خالی است.</div> }
    </div>
</div>

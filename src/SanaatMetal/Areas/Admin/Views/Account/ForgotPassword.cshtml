@model SanaatMetal.Areas.Admin.Controllers.ForgotPasswordVm
@{ Layout = "_AuthLayout"; ViewData["Title"] = "بازیابی رمز عبور"; }
@if (ViewBag.Sent == true)
{
    <div class="alert alert-success small" style="line-height:2">
        <i class="bi bi-envelope-check ic"></i>اگر این حساب متعلق به <b>مدیر کل</b> باشد، لینک تعیین رمز جدید به ایمیل ثبت‌شده آن ارسال شد (پوشه Spam را هم ببینید). لینک ۲ ساعت معتبر است.
    </div>
    <div class="small text-white-50" style="line-height:2"><i class="bi bi-info-circle ic"></i>سایر کاربران پنل برای بازیابی رمز عبور باید با مدیر کل تماس بگیرند؛ فقط مدیر کل می‌تواند رمز کاربران را ریست کند.</div>
}
else
{
    <form method="post" asp-action="ForgotPassword">
        <div asp-validation-summary="All" class="text-warning small mb-2"></div>
        <p class="small text-white-50" style="line-height:2">نام کاربری یا ایمیل حساب مدیر کل را وارد کنید تا لینک تعیین رمز جدید به ایمیل آن ارسال شود. سایر کاربران برای ریست رمز با مدیر کل تماس بگیرند.</p>
        <div class="mb-4">
            <label class="form-label" asp-for="UserNameOrEmail">نام کاربری یا ایمیل</label>
            <input class="form-control ltr" asp-for="UserNameOrEmail" autocomplete="username" autofocus maxlength="256" />
        </div>
        <button class="btn btn-a-accent w-100 py-2 fs-6" type="submit"><i class="bi bi-send ic"></i>ارسال لینک بازیابی</button>
    </form>
}
@section Links { <a asp-action="Login" class="text-white-50 small"><i class="bi bi-box-arrow-in-left ic"></i>ورود</a> }

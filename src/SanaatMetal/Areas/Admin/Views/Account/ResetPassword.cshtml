@model SanaatMetal.Areas.Admin.Controllers.ResetPasswordVm
@{ Layout = "_AuthLayout"; ViewData["Title"] = "تعیین رمز عبور جدید"; }
@if (ViewBag.Invalid == true)
{
    <div class="alert alert-warning small" style="line-height:2"><i class="bi bi-exclamation-triangle ic"></i>این لینک نامعتبر است یا منقضی شده (اعتبار لینک ۲ ساعت است و فقط یک بار کار می‌کند). دوباره درخواست بازیابی بدهید یا از مدیر کل بخواهید لینک جدید بفرستد.</div>
}
else
{
    <form method="post" asp-action="ResetPassword">
        <div asp-validation-summary="All" class="text-warning small mb-2"></div>
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="Code" />
        @if (ViewBag.UserName is string un) { <p class="small text-white-50 mb-3">نام کاربری: <b class="ltr d-inline-block">@un</b></p> }
        <div class="mb-3">
            <label class="form-label" asp-for="NewPassword">رمز عبور جدید</label>
            <input class="form-control ltr" asp-for="NewPassword" autocomplete="new-password" autofocus maxlength="128" />
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="ConfirmPassword">تکرار رمز عبور جدید</label>
            <input class="form-control ltr" asp-for="ConfirmPassword" autocomplete="new-password" maxlength="128" />
        </div>
        <p class="small text-white-50 mb-4">حداقل ۱۰ کاراکتر، شامل حرف بزرگ و کوچک انگلیسی، عدد و یک نماد (مثل @@ یا #).</p>
        <button class="btn btn-a-accent w-100 py-2 fs-6" type="submit"><i class="bi bi-key ic"></i>ذخیره رمز جدید</button>
    </form>
}
@section Links { <a asp-action="ForgotPassword" class="text-white-50 small"><i class="bi bi-arrow-repeat ic"></i>درخواست لینک جدید</a> <a asp-action="Login" class="text-white-50 small"><i class="bi bi-box-arrow-in-left ic"></i>ورود</a> }

@model List<ContactMessage>
@{ ViewData["Title"] = "پیام‌ها و ایمیل‌ها"; string? filter = ViewBag.Filter; int page = ViewBag.Page, pages = ViewBag.Pages; }
<div class="a-card">
    <div class="a-card-head">
        <h5><i class="bi bi-envelope-paper ic text-primary"></i>پیام‌های فرم صفحه اصلی</h5>
        <ul class="nav nav-pills gap-1">
            @foreach (var (key, title) in new[] { ("", "همه"), ("unread", "خوانده‌نشده"), ("failed", "ایمیل‌نشده"), ("archived", "بایگانی") })
            {
                <li class="nav-item"><a class="nav-link py-1 px-3 small @((filter ?? "") == key ? "active" : "")" asp-route-filter="@key">@title</a></li>
            }
        </ul>
    </div>
    <form class="a-card-body border-bottom row g-2" method="get">
        <input type="hidden" name="filter" value="@filter" />
        <div class="col-md-10"><input class="form-control" name="q" value="@ViewBag.Q" placeholder="جستجو نام، ایمیل، متن..." /></div>
        <div class="col-md-2"><button class="btn btn-soft w-100"><i class="bi bi-search ic"></i>جستجو</button></div>
    </form>
    <div class="list-group list-group-flush">
        @foreach (var m in Model)
        {
            <a asp-action="Details" asp-route-id="@m.Id" class="list-group-item list-group-item-action bg-transparent d-flex gap-3 align-items-center py-3">
                <span class="a-avatar">@(m.Name.Length > 0 ? m.Name[..1] : "?")</span>
                <div class="flex-grow-1 min-w-0">
                    <div class="d-flex justify-content-between gap-2">
                        <span class="@(m.IsRead ? "" : "fw-black text-primary")">@m.Name <span class="small text-muted ltr d-inline-block">&lt;@m.Email&gt;</span></span>
                        <small class="text-muted text-nowrap">@D(m.CreatedAt, true)</small>
                    </div>
                    <div class="small fw-bold">@m.Subject</div>
                    <div class="small text-muted text-truncate">@m.Body</div>
                </div>
                @if (m.EmailSent) { <span class="pill pill-green" title="ایمیل شد"><i class="bi bi-envelope-check"></i></span> } else { <span class="pill pill-orange" title="ایمیل نشد — فقط در دیتابیس"><i class="bi bi-database"></i></span> }
            </a>
        }
    </div>
    @if (Model.Count == 0) { <div class="a-empty"><i class="bi bi-inbox"></i>پیامی وجود ندارد.</div> }
    @if (pages > 1) { <nav class="p-3"><ul class="pagination justify-content-center mb-0">@for (var i = 1; i <= pages; i++) { <li class="page-item @(i == page ? "active" : "")"><a class="page-link" asp-route-page="@i" asp-route-q="@ViewBag.Q" asp-route-filter="@filter">@N(i)</a></li> }</ul></nav> }
</div>

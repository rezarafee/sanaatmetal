<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- IIS به طور پیش‌فرض درخواست‌های بیشتر از ۲۸ مگابایت را قبل از رسیدن به برنامه رد می‌کند؛ برای بارگذاری چند عکس و مستند با هم تا ۱۰۰ مگابایت -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="104857600" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
